class PayAccessibilityService : AccessibilityService() {
    private data class LinePayRow(val tx:LinePayTransaction, val node:AccessibilityNodeInfo, val bounds:Rect)
    private data class PiWalletRow(val tx:PiWalletTransaction, val node:AccessibilityNodeInfo, val bounds:Rect)
    companion object {
        var instance: PayAccessibilityService? = null
        private const val JKO = "com.jkos.app"
        private const val LINE_PAY = "com.linepaytw.upay"
        private const val LINE_APP = "jp.naver.line.android"
        private const val PI_WALLET = "tw.com.pchome.android.pi"
        private const val SELF = "com.bou.payhelper"
        private const val GOOGLE_WALLET = "com.google.android.apps.walletnfcrel"
    }
    private val h=Handler(Looper.getMainLooper())
    // V2.41: serialize LINE Pay state-machine work. Accessibility events can arrive
    // dozens of times for one WebView mutation; only one formal tick may be queued.
    private var linePayFormalScheduled=false
    private val linePayFormalRunnable=Runnable {
        linePayFormalScheduled=false
        processLinePayFormal()
    }
    private var running=false
    private var stage=0
    private var myAttempts=0
    private var txAttempts=0
    private var transactionClickPending=false
    private var transactionClickAt=0L
    private var page=0
    private var sample=0
    private var stableSamples=0
    private var noNewPages=0
    private var lastCompletedPageSignature=""
    private val collected=LinkedHashSet<String>()
    private var lastSignature=""
    private var detailStarted=false
    private var detailIndex=0
    private var currentDetailKey=""
    private val detailKeys=ArrayList<String>()
    private var detailWaitAttempts=0
    private var detailParseAttempts=0
    private var detailClickAt=0L
    private val detailFailedKeys=HashSet<String>()
    private var revisitPass=0
    private var rewindStable=0
    private var rewindLastSignature=""
    private val knownAtStart=HashSet<String>()
    private var repairMode=false
    private var newTransactionsThisRun=0
    private var completedDetailsThisRun=0
    private var consecutiveKnownPages=0
    private var initialRewindPending=false
    private var initialRewindDone=false
    private var linePayDiagnosticRunning=false
    private var lastLinePayCaptureAt=0L
    private var lastLinePaySignature=""
    private var lineNavStage=0
    private var lineNavAttempts=0
    private var lineNavLastActionAt=0L
    private var linePayFormalMode=false
    private var linePayHistoryEntered=false
    private var linePayHistoryPage=0
    private var linePayHistoryNoMove=0
    private var linePayHistoryScrollInFlight=false
    private var linePayHistoryBeforeScrollSignature=""
    private var linePayHistoryFallbackUsed=false
    private var linePayConsecutiveKnownPages=0
    private val linePayKnownAtStart=HashSet<String>()
    private var linePayRepairMode=false
    private var linePayNewThisRun=0
    private var linePayDetailsThisRun=0
    private var linePayCurrentDetailKey=""
    private var linePayDetailClickedAt=0L
    private var linePayDetailParseAttempts=0
    private var linePayReturnPending=false
    private var linePayHistoryOpenedAt=0L
    private var linePayHistoryEmptyPolls=0
    private var linePayHistoryLiffSeen=false
    private var linePayHistoryReopenAttempts=0
    private var linePayHistoryLastCaptureAt=0L
    private var linePayLastProcessedPageFingerprint=""
    private var linePayLastProcessedPageAt=0L
    private var linePayDetailSuccessCommitted=false
    private var linePayOlderRangeOpened=false
    private var linePayFullHistoryMode=false
    private var piDiagnosticRunning=false
    private var lastPiCaptureAt=0L
    private var lastPiSignature=""
    private var piFormalMode=false
    private var piFormalScheduled=false
    private var piNavStage=0
    private var piCurrentDetailKey=""
    private var piDetailClickedAt=0L
    private var piNewThisRun=0
    private var piDetailsThisRun=0
    private var piConsecutiveKnownPages=0
    private var piPage=0
    private var piLastPageFingerprint=""
    private var piDetailOpening=false
    private var piReturnPending=false
    private val piFailedDetailKeys=HashSet<String>()
    private val piKnownAtStart=HashSet<String>()
    private var googleWalletDiagnosticRunning=false
    private var lastGoogleWalletCaptureAt=0L
    private var lastGoogleWalletSignature=""
    private val piFormalRunnable=Runnable {
        piFormalScheduled=false
        processPiFormal()
    }

    override fun onServiceConnected(){ super.onServiceConnected(); instance=this; log("Accessibility 已連線") }
    override fun onInterrupt(){}
    override fun onDestroy(){ instance=null; h.removeCallbacksAndMessages(null); super.onDestroy() }
    override fun onAccessibilityEvent(e:AccessibilityEvent?){
        val pkg=e?.packageName?.toString().orEmpty()
        if(running && pkg==JKO) h.postDelayed({step()},350)
        if(linePayDiagnosticRunning && (pkg==LINE_PAY || pkg==LINE_APP)) {
            h.postDelayed({
                captureLinePayDiagnostic(e)
                autoNavigateLinePay()
                if(linePayFormalMode) scheduleLinePayFormal(180)
            }, 220)
        }
        if(piDiagnosticRunning && pkg==PI_WALLET) h.postDelayed({ capturePiDiagnostic(e) },220)
        if(piFormalMode && pkg==PI_WALLET) schedulePiFormal(180)
        if(googleWalletDiagnosticRunning && pkg==GOOGLE_WALLET) h.postDelayed({ captureGoogleWalletDiagnostic(e) },220)
    }

    fun startGoogleWalletDiagnostic(){
        if(running || linePayFormalMode || piFormalMode){ log("⚠ 其他支付同步進行中，請完成後再啟動 Google Wallet 診斷"); return }
        googleWalletDiagnosticRunning=true
        lastGoogleWalletCaptureAt=0L
        lastGoogleWalletSignature=""
        GoogleWalletDiagnosticStore.clear(this)
        log("=== Pay Helper Google Wallet 交易紀錄診斷開始：請進入『查看更多交易』並點開一筆交易 ===")
        val launch=packageManager.getLaunchIntentForPackage(GOOGLE_WALLET)
        if(launch==null){ googleWalletDiagnosticRunning=false; log("⚠ 找不到 Google Wallet App；package=$GOOGLE_WALLET"); return }
        launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
        startActivity(launch)
        h.postDelayed({ captureGoogleWalletDiagnostic(null) },1200)
    }

    fun stopGoogleWalletDiagnostic(returnToApp:Boolean=true){
        googleWalletDiagnosticRunning=false
        log("=== Pay Helper Google Wallet 交易紀錄診斷停止 ===")
        if(returnToApp){
            packageManager.getLaunchIntentForPackage(SELF)?.let{
                it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
                startActivity(it)
            }
        }
    }

    private fun captureGoogleWalletDiagnostic(e:AccessibilityEvent?){
        if(!googleWalletDiagnosticRunning) return
        val root=rootInActiveWindow ?: return
        val pkg=root.packageName?.toString().orEmpty()
        if(pkg!=GOOGLE_WALLET) return
        val visible=visibleTexts(root).joinToString("\n")
        val tree=dumpTree(root,650).take(40000)
        val signature=(visible+"\n"+tree).take(60000)
        val now=System.currentTimeMillis()
        if(signature==lastGoogleWalletSignature && now-lastGoogleWalletCaptureAt<1200) return
        lastGoogleWalletSignature=signature
        lastGoogleWalletCaptureAt=now
        GoogleWalletDiagnosticStore.add(this, GoogleWalletDiagnosticCapture(
            time=now, packageName=pkg, eventType=e?.eventType ?: 0,
            eventClass=e?.className?.toString().orEmpty(),
            eventText=e?.text?.joinToString(" | ").orEmpty(),
            visibleText=visible, tree=tree
        ))
        log("Google Wallet 診斷已保存畫面：title=[${e?.text?.joinToString(" | ").orEmpty()}]")
    }

    private fun scheduleLinePayFormal(delayMs:Long=220L){
        if(!linePayFormalMode) return
        if(linePayFormalScheduled) return
        linePayFormalScheduled=true
        h.postDelayed(linePayFormalRunnable,delayMs)
